# Copy to `.env` for your own reference, then set these as real environment
# variables in your shell/session -- this project does NOT auto-load a
# `.env` file (no python-dotenv or similar in use). All four are optional;
# without them the pipeline still runs fully in offline mode from the local
# candles cache, and any Google Sheets export step will raise a clear
# ValueError instead of silently doing nothing.

# Binance API (only needed for live/online candle pulls; unused in the
# default offline mode)
BINANCE_API_KEY=your_key
BINANCE_API_SECRET=your_secret

# Google Sheets export (only needed for --export-gsheet / the dashboard's
# push-to-gsheet button)
GOOGLE_SERVICE_KEY_PATH=SERVICE KEY/your-service-account-key.json
GOOGLE_SHEET_ID=your_google_sheet_id_here
